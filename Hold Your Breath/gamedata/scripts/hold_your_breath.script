-- Hold Your Breath
-- Version: 0.717
-- Author: Boeker

local BHS_EFFECTOR_ID = 9921
local BHS_EFFECTS_MULT = 1 -- zzz_player_injuries.script: effects_mult (never reassigned there)
local BHS_MAXHP_ARM = 5 -- zzz_player_injuries.script: maxhp.rightarm / maxhp.leftarm
local EXHAUSTED_SOUND = "characters_voice\\player\\exhausted_3" -- plain breath, not a dramatic gasp - the only variant wanted; _1/_2/_4 are gaspier and unwanted
local STAMINA_STOP_THRESHOLD = 0.10 -- auto-release once stamina drops to this fraction remaining, instead of waiting for it to hit exactly 0

-- ----------------------------------------------------------------------------
-- CONFIG
-- ----------------------------------------------------------------------------
CONFIG = {
	activation_mode = "hold",
	enabled = true,
	hold_in_time = 1.0,
	keybind = DIK_keys.DIK_SPACE,
	release_ramp_time = 0.3, -- eases 0 -> the spike on release, instead of an instant jump
	release_spike = 3, -- release ramps up to real target * this, before easing back down to it
	release_time = 0.6,
	stamina_drain_time = 45, -- seconds of holding breath to fully drain stamina; 0 disables the cost
}

-- ----------------------------------------------------------------------------
-- STATE
-- ----------------------------------------------------------------------------
STATE = {
	factor = 0,
	holding_breath = false,
	is_zoomed = false,
	phase = "idle", -- "idle" | "holding_in" | "held" | "release_ramp" | "releasing"
	phase_start = 0,
	phase_start_factor = 0, -- value STATE.factor is easing FROM in the current phase
	release_target = 0, -- cam_power computed fresh at the moment of release
	stamina_last_tick = 0, -- time_global() of the last stamina drain step, reset on press
}

-- ----------------------------------------------------------------------------
-- Helpers, alphabetical
-- ----------------------------------------------------------------------------
local compute_cam_power, ease_out, get_body_state, smoothstep

-- Replicates BHS's shaking_hands() cam_power formula exactly. Reads health
-- via utils_obj since BHS's own health/maxhp/effects_mult are file-local.
compute_cam_power = function()
	local activeslot = db.actor:active_slot()
	if not (activeslot == 2 or activeslot == 3 or activeslot == 1) then return 0 end

	local item_in_slot = db.actor:item_in_slot(activeslot)
	if not item_in_slot then return 0 end

	local section_name = item_in_slot:section()
	if not ini_sys:section_exist(section_name, "inv_weight") then return 0 end
	local weight = ini_sys:r_float_ex(section_name, "inv_weight")

	local health_rightarm = utils_obj.load_var(db.actor, "health.rightarm") or BHS_MAXHP_ARM
	local health_leftarm = utils_obj.load_var(db.actor, "health.leftarm") or BHS_MAXHP_ARM

	local left_arm = health_rightarm * BHS_EFFECTS_MULT
	left_arm = left_arm >= 1 and left_arm or 0.75
	local right_arm = health_leftarm * BHS_EFFECTS_MULT
	right_arm = right_arm >= 1 and right_arm or 0.75
	local arms_sum = left_arm + right_arm
	local max_arms_sum = (BHS_MAXHP_ARM + BHS_MAXHP_ARM) * BHS_EFFECTS_MULT

	if arms_sum >= (max_arms_sum * (zzz_player_injuries_mcm.get_config("arm_penalty_minimum_hp") * 0.1)) then
		return 0
	end

	local body_state = get_body_state()
	local cam_power

	if (left_arm < right_arm / 1.5) or (right_arm < left_arm / 1.5) then
		cam_power = 1.15 * weight / arms_sum
		cam_power = (body_state == "crouch") and (0.8 * weight / arms_sum) or cam_power
		cam_power = (body_state == "low_crouch") and (0.4 * weight / arms_sum) or cam_power
	else
		cam_power = 0.8 * weight / arms_sum
		cam_power = (body_state == "crouch") and (0.55 * weight / arms_sum) or cam_power
		cam_power = (body_state == "low_crouch") and (0.3 * weight / arms_sum) or cam_power
	end

	cam_power = clamp(cam_power, 0, 3)
	cam_power = cam_power * zzz_player_injuries_mcm.get_config("arm_animation_power")

	if item_in_slot:weapon_is_scope() then
		cam_power = cam_power * 0.2
	end

	return cam_power
end

-- Fast initial response, decelerating into the target - used for
-- release_ramp so the spike visibly starts moving the instant the key is
-- released, instead of smoothstep's near-zero initial rate reading as a delay.
ease_out = function(t)
	return 1 - (1 - t) * (1 - t)
end

-- Own copy of BHS's get_body_state() - its global isn't reliably callable
-- from another script at runtime, so this is inlined instead.
get_body_state = function()
	local crouch = IsMoveState("mcCrouch")
	local accel = IsMoveState("mcAccel")
	if crouch then
		if accel then return "low_crouch" end
		return "crouch"
	end
	return "stand"
end

smoothstep = function(t)
	return 3 * t * t - 2 * t * t * t
end

-- ----------------------------------------------------------------------------
-- Callbacks, alphabetical
-- ----------------------------------------------------------------------------

-- Drives the press/hold/release state machine, writing STATE.factor to
-- BHS's effector every frame we're actively modulating it.
function actor_on_update()
	if not STATE.is_zoomed then return end
	if STATE.phase == "idle" then return end
	if not level.check_cam_effector(BHS_EFFECTOR_ID) then return end

	if STATE.holding_breath and CONFIG.stamina_drain_time > 0 then
		local now = time_global()
		local dt = (now - STATE.stamina_last_tick) / 1000
		STATE.stamina_last_tick = now
		db.actor.power = clamp(db.actor.power - dt / CONFIG.stamina_drain_time, 0, 1)
		if db.actor.power <= STAMINA_STOP_THRESHOLD then
			stop_holding_breath()
			return
		end
	end

	if STATE.phase == "held" then
		STATE.factor = 0
	else
		local duration, target
		if STATE.phase == "holding_in" then
			duration, target = CONFIG.hold_in_time, 0
		elseif STATE.phase == "release_ramp" then
			duration, target = CONFIG.release_ramp_time, STATE.release_target * CONFIG.release_spike
		else -- "releasing"
			duration, target = CONFIG.release_time, STATE.release_target
		end

		local elapsed = (time_global() - STATE.phase_start) / 1000
		local t = (duration > 0) and clamp(elapsed / duration, 0, 1) or 1
		local eased_t = (STATE.phase == "release_ramp") and ease_out(t) or smoothstep(t)

		STATE.factor = STATE.phase_start_factor + (target - STATE.phase_start_factor) * eased_t

		if t >= 1 then
			STATE.factor = target
			if STATE.phase == "holding_in" then
				STATE.phase = "held"
			elseif STATE.phase == "release_ramp" then
				STATE.phase = "releasing"
				STATE.phase_start = time_global()
				STATE.phase_start_factor = target
			else
				STATE.phase = "idle"
			end
		end
	end

	level.set_cam_effector_factor(BHS_EFFECTOR_ID, STATE.factor)
end

function actor_on_weapon_zoom_in(wpn)
	STATE.is_zoomed = true
end

function actor_on_weapon_zoom_out(wpn)
	STATE.is_zoomed = false
	STATE.holding_breath = false
	reset_effector()
end

function get_config()
	if not ui_mcm then return end
	CONFIG.activation_mode = ui_mcm.get("hold_your_breath/activation_mode") or CONFIG.activation_mode
	CONFIG.enabled = ui_mcm.get("hold_your_breath/enabled")
	if CONFIG.enabled == nil then CONFIG.enabled = true end
	CONFIG.hold_in_time = ui_mcm.get("hold_your_breath/hold_in_time") or CONFIG.hold_in_time
	CONFIG.keybind = ui_mcm.get("hold_your_breath/keybind") or CONFIG.keybind
	CONFIG.release_ramp_time = ui_mcm.get("hold_your_breath/release_ramp_time") or CONFIG.release_ramp_time
	CONFIG.release_spike = ui_mcm.get("hold_your_breath/release_spike") or CONFIG.release_spike
	CONFIG.release_time = ui_mcm.get("hold_your_breath/release_time") or CONFIG.release_time
	CONFIG.stamina_drain_time = ui_mcm.get("hold_your_breath/stamina_drain_time") or CONFIG.stamina_drain_time
end

function on_before_key_hold(key, bind, dis, flags)
	if not CONFIG.enabled then return end
	if key ~= CONFIG.keybind then return end
	if not STATE.is_zoomed then return end
	flags.ret_value = false
end

function on_before_key_press(key, bind, dis, flags)
	if not CONFIG.enabled then return end
	if key ~= CONFIG.keybind then return end
	if not STATE.is_zoomed then return end
	flags.ret_value = false
	if CONFIG.activation_mode == "hold" then
		start_holding_breath()
	elseif CONFIG.activation_mode == "toggle" then
		if STATE.holding_breath then
			stop_holding_breath()
		else
			start_holding_breath()
		end
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_before_death", actor_on_weapon_zoom_out)
	RegisterScriptCallback("actor_on_first_update", get_config)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_weapon_zoom_out)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_weapon_zoom_in", actor_on_weapon_zoom_in)
	RegisterScriptCallback("actor_on_weapon_zoom_out", actor_on_weapon_zoom_out)
	RegisterScriptCallback("on_before_key_hold", on_before_key_hold)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("on_option_change", get_config)
end

function on_key_release(dik)
	if CONFIG.activation_mode ~= "hold" then return end
	if dik ~= CONFIG.keybind then return end
	stop_holding_breath()
end

-- Hard, immediate reset for unzoom/death/net-destroy, where a ramp
-- wouldn't be visible anyway - guarantees the effector is never stuck low.
function reset_effector()
	STATE.phase = "idle"
	STATE.factor = compute_cam_power()
	if level.check_cam_effector(BHS_EFFECTOR_ID) then
		level.set_cam_effector_factor(BHS_EFFECTOR_ID, STATE.factor)
	end
end

function start_holding_breath()
	if STATE.holding_breath then return end
	STATE.holding_breath = true
	STATE.phase = "holding_in"
	STATE.phase_start = time_global()
	STATE.phase_start_factor = compute_cam_power()
	STATE.stamina_last_tick = STATE.phase_start
end

-- Eases up to a spike above the real target, then actor_on_update eases
-- back down to it. Also plays EXHAUSTED_SOUND on every release (not just
-- when actually out of stamina), wrapped in pcall as a general safety net.
function stop_holding_breath()
	if not STATE.holding_breath then return end
	STATE.holding_breath = false
	STATE.release_target = compute_cam_power()
	STATE.phase = "release_ramp"
	STATE.phase_start = time_global()
	STATE.phase_start_factor = STATE.factor
	pcall(function()
		local snd = sound_object(EXHAUSTED_SOUND)
		snd:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
	end)
end
